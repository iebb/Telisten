    "On a signed-in device, open Telegram Settings → Devices → Link Desktop Device, then scan this code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a signed-in device, open Telegram Settings → Devices → Link Desktop Device, then scan this code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已登录的设备上，打开 Telegram 设置 → 设备 → 链接桌面设备，然后扫描此代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在已登入的裝置上，開啟 Telegram 設定 → 裝置 → 連結桌面設備，然後掃描此程式碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしたデバイスで、[Telegram 設定] → [デバイス] → [デスクトップ デバイスのリンク] を開き、このコードをスキャンします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên thiết bị đã đăng nhập, mở Cài đặt Telegram → Thiết bị → Liên kết thiết bị máy tính để bàn, sau đó quét mã này."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un appareil connecté, ouvrez Paramètres Telegram → Appareils → Lier un appareil de bureau, puis scannez ce code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un dispositivo registrado, abra Configuración de Telegram → Dispositivos → Vincular dispositivo de escritorio, luego escanee este código."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인된 장치에서 텔레그램 설정 → 장치 → 데스크톱 장치 연결을 열고 이 코드를 스캔하세요."
          }
        }
      }
    },
