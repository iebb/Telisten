    "Search prefix and suffix must each be 256 characters or fewer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search prefix and suffix must each be 256 characters or fewer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索前缀和后缀不得超过 256 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋前綴和後綴不得超過 256 個字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索プレフィックスとサフィックスはそれぞれ 256 文字以下である必要があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tiền tố và hậu tố tìm kiếm phải có 256 ký tự trở xuống."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le préfixe et le suffixe de recherche doivent chacun comporter 256 caractères maximum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prefijo y el sufijo de búsqueda deben tener 256 caracteres o menos cada uno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 접두사와 접미사는 각각 256자 이하여야 합니다."
          }
        }
      }
    },
    "Search prefix and suffix must each be a single line.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search prefix and suffix must each be a single line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索前缀和后缀必须各为一行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋前綴和後綴必須各為一行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索プレフィックスとサフィックスはそれぞれ 1 行である必要があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiền tố và hậu tố tìm kiếm phải nằm trên một dòng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le préfixe et le suffixe de recherche doivent chacun être constitués d’une seule ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prefijo y el sufijo de búsqueda deben estar en una sola línea."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 접두사와 접미사는 각각 한 줄이어야 합니다."
          }
        }
      }
    },
    "Search results and bot controls appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search results and bot controls appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索结果和机器人控件显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋結果和機器人控制顯示在此。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索結果とボット コントロールがここに表示されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả tìm kiếm và điều khiển bot xuất hiện ở đây."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats de recherche et les commandes du bot apparaissent ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de la búsqueda y los controles de bot aparecen aquí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 결과와 봇 컨트롤이 여기에 표시됩니다."
          }
        }
      }
    },
    "Search results open as a simple bot conversation, including the bot’s interactive buttons.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search results open as a simple bot conversation, including the bot’s interactive buttons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索结果以简单的机器人对话形式打开，包括机器人的交互按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋結果會以簡潔的機器人對話呈現，包含機器人的互動按鈕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索結果は、ボットのインタラクティブ ボタンを含む単純なボットの会話として開きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả tìm kiếm mở ra dưới dạng một cuộc trò chuyện đơn giản với bot, bao gồm các nút tương tác của bot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats de recherche s’ouvrent sous la forme d’une simple conversation avec le bot, y compris ses boutons interactifs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de la búsqueda se abren como una simple conversación con el bot, incluidos los botones interactivos del bot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 결과는 봇의 대화형 버튼을 포함하여 간단한 봇 대화로 열립니다."
          }
        }
      }
    },
