          "stringUnit": {
            "state": "translated",
            "value": "在已登入的裝置上，開啟 Telegram 設定 → 裝置 → 連結桌面裝置，然後掃描此 QR 碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしたデバイスで、[Telegram 設定] → [デバイス] → [デスクトップ デバイスのリンク] を開き、このコードをスキャンします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên thiết bị đã đăng nhập, mở Cài đặt Telegram → Thiết bị → Liên kết thiết bị máy tính để bàn, sau đó quét mã này."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un appareil connecté, ouvrez Paramètres Telegram → Appareils → Lier un appareil de bureau, puis scannez ce code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un dispositivo con la sesión iniciada, abre Configuración de Telegram → Dispositivos → Vincular dispositivo de escritorio y luego escanea este código."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인된 기기에서 Telegram 설정 → 기기 → 데스크톱 기기 연결을 열고 이 코드를 스캔하세요."
          }
        }
      }
    },
