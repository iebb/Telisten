    },
    "Search results open as a simple bot conversation, including the bot’s interactive buttons.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search results open as a simple bot conversation, including the bot’s interactive buttons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索结果以简单的机器人对话形式打开，包括机器人的交互按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋結果會以簡潔的機器人對話呈現，包含機器人的互動按鈕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
