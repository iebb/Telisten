            "value": "Seul un administrateur peut démarrer Listen Together dans ce groupe ou ce canal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un administrador puede iniciar Escuchar juntos en este grupo o canal."
