    "Search bot configurations are stored in iCloud Keychain. No bot is included by default.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search bot configurations are stored in iCloud Keychain. No bot is included by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索机器人配置存储在 iCloud 钥匙串中。默认情况下不包含机器人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋機器人設定儲存在 iCloud 鑰匙圈中。預設不包含機器人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索ボットの設定は iCloud キーチェーンに保存されます。デフォルトではボットは含まれていません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình bot tìm kiếm được lưu trữ trong Chuỗi khóa iCloud. Không có bot nào được bao gồm theo mặc định."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les configurations des bots de recherche sont stockées dans le trousseau iCloud. Aucun bot n'est inclus par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las configuraciones de los bots de búsqueda se almacenan en el Llavero de iCloud. No se incluye ningún bot de forma predeterminada."
          }
        },
        "ko": {
          "stringUnit": {
