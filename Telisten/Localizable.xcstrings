    "Pick a playlist, favorite, download, or music source from the sidebar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a playlist, favorite, download, or music source from the sidebar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从侧边栏中选择播放列表、收藏夹、下载或音乐源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從側邊欄中選擇播放清單、收藏夾、下載或音樂來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーからプレイリスト、お気に入り、ダウンロード、または音楽ソースを選択します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn danh sách phát, mục yêu thích, tải xuống hoặc nguồn nhạc từ thanh bên."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une playlist, un favori, un téléchargement ou une source musicale dans la barre latérale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una lista de reproducción, un favorito, una descarga o una fuente de música en la barra lateral."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 재생목록, 즐겨찾기, 다운로드 또는 음악 소스를 선택하세요."
          }
        }
      }
    },
    "Pinned chat": {
      "localizations": {
