    "Add TELEGRAM_API_ID and TELEGRAM_API_HASH to the gitignored .env file, run Scripts/generate-local-config.sh, then relaunch the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add TELEGRAM_API_ID and TELEGRAM_API_HASH to the gitignored .env file, run Scripts/generate-local-config.sh, then relaunch the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 TELEGRAM_API_ID 和 TELEGRAM_API_HASH 添加到 gitignored .env 文件中，运行 Scripts/generate-local-config.sh，然后重新启动应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 TELEGRAM_API_ID 和 TELEGRAM_API_HASH 新增至 gitignored .env 檔案中，執行 Scripts/generate-local-config.sh，然後重新啟動應用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TELEGRAM_API_ID と TELEGRAM_API_HASH を gitignored .env ファイルに追加し、Scripts/generate-local-config.sh を実行して、アプリを再起動します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm TELEGRAM_API_ID và TELEGRAM_API_HASH vào tệp .env được gitignored, chạy Scripts/generate-local-config.sh, sau đó khởi chạy lại ứng dụng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez TELEGRAM_API_ID et TELEGRAM_API_HASH au fichier gitignored .env, exécutez Scripts/generate-local-config.sh, puis relancez l'application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue TELEGRAM_API_ID y TELEGRAM_API_HASH al archivo .env ignorado por git, ejecute Scripts/generate-local-config.sh y luego reinicie la aplicación."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "gitignored .env 파일에 TELEGRAM_API_ID 및 TELEGRAM_API_HASH를 추가하고 Scripts/generate-local-config.sh를 실행한 다음 앱을 다시 시작하세요."
          }
        }
      }
    },
