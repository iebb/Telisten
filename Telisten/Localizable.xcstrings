    "Only an administrator can start Listen Together in this group or channel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an administrator can start Listen Together in this group or channel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员才能在此群组或频道中开始一起听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理員才能在此群組或頻道中開始一起聽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループまたはチャンネルで「一緒に聴く」を開始できるのは管理者だけです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
