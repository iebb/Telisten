    "Add TELEGRAM_API_ID and TELEGRAM_API_HASH to the gitignored .env file, run Scripts/generate-local-config.sh, then relaunch the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add TELEGRAM_API_ID and TELEGRAM_API_HASH to the gitignored .env file, run Scripts/generate-local-config.sh, then relaunch the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 TELEGRAM_API_ID 和 TELEGRAM_API_HASH 添加到 gitignored .env 文件中，运行 Scripts/generate-local-config.sh，然后重新启动应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 TELEGRAM_API_ID 和 TELEGRAM_API_HASH 新增至 gitignored .env 檔案中，執行 Scripts/generate-local-config.sh，然後重新啟動應用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "gitignore 対象の .env ファイルに TELEGRAM_API_ID と TELEGRAM_API_HASH を追加し、Scripts/generate-local-config.sh を実行してから、アプリを再起動してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm TELEGRAM_API_ID và TELEGRAM_API_HASH vào tệp .env (đã được gitignore), chạy Scripts/generate-local-config.sh, sau đó mở lại ứng dụng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez TELEGRAM_API_ID et TELEGRAM_API_HASH au fichier .env ignoré par Git, exécutez Scripts/generate-local-config.sh, puis relancez l'application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega TELEGRAM_API_ID y TELEGRAM_API_HASH al archivo .env ignorado por git, ejecuta Scripts/generate-local-config.sh y luego vuelve a abrir la aplicación."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "gitignored .env 파일에 TELEGRAM_API_ID 및 TELEGRAM_API_HASH를 추가하고 Scripts/generate-local-config.sh를 실행한 다음 앱을 다시 시작하세요."
          }
        }
      }
    },
    "Add a Telegram search bot in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a Telegram search bot in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中添加 Telegram 搜索机器人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中新增 Telegram 搜尋機器人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で Telegram 検索ボットを追加してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm bot tìm kiếm Telegram trong Cài đặt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un bot de recherche Telegram dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un bot de búsqueda de Telegram en Configuración."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Telegram 검색 봇을 추가하세요."
          }
        }
      }
    },
    "Add search bot": {
