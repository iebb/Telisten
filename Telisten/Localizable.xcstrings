    "Create this account in the official Telegram app before signing in here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create this account in the official Telegram app before signing in here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此处登录之前，请在官方 Telegram 应用程序中创建此账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此處登入之前，請在官方 Telegram 應用程式中建立此帳戶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにサインインする前に、公式 Telegram アプリでこのアカウントを作成してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo tài khoản này trong ứng dụng Telegram chính thức trước khi đăng nhập tại đây."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez ce compte dans l'application Telegram officielle avant de vous connecter ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea esta cuenta en la aplicación oficial de Telegram antes de iniciar sesión aquí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 로그인하기 전에 공식 Telegram 앱에서 이 계정을 만드세요."
          }
        }
      }
    },
    "Creates a private Telegram channel in %@. If the folder is full, the playlist stays available in Telisten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a private Telegram channel in %@. If the folder is full, the playlist stays available in Telisten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 中创建一个私人 Telegram 频道。如果文件夹已满，播放列表在 Telisten 中仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 中建立一個私人 Telegram 頻道。如果資料夾已滿，播放清單在 Telisten 中仍然可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にプライベートな Telegram チャンネルを作成します。フォルダーがいっぱいの場合でも、プレイリストは引き続き Telisten で利用できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo kênh Telegram riêng tư trong %@. Nếu thư mục đầy, danh sách phát vẫn có trong Telisten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une chaîne Telegram privée dans %@. Si le dossier est plein, la playlist reste disponible dans Telisten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un canal privado de Telegram en %@. Si la carpeta está llena, la lista de reproducción permanece disponible en Telisten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 폴더에 비공개 Telegram 채널을 생성합니다. 폴더가 가득 차도 재생목록은 Telisten에서 계속 사용할 수 있습니다."
          }
        }
      }
    },
