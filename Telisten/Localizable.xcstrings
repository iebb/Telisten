    "Telegram expired this track reference. Telisten could not refresh it automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram expired this track reference. Telisten could not refresh it automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram 使该曲目参考过期。 Telisten 无法自动刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram 讓該曲目參考過期。 Telisten 無法自動刷新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram はこのトラック参照の有効期限を切りました。 Telisten は自動的に更新できませんでした。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
