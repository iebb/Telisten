    "A private player for every track already living in your Telegram account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private player for every track already living in your Telegram account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为您 Telegram 账户中已有的每首歌曲打造的私人播放器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為您 Telegram 帳戶中已有的每首歌曲打造的私人播放器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram アカウントにあるすべての曲を、プライベートなプレーヤーで。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình phát riêng tư cho mọi bản nhạc đã có trong tài khoản Telegram của bạn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lecteur privé pour tous les morceaux déjà présents dans votre compte Telegram."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reproductor privado para todas las canciones que ya están en tu cuenta de Telegram."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram 계정에 이미 있는 모든 트랙을 위한 개인 플레이어."
          }
        }
      }
    },
    "A selected contact has joined Telegram’s maximum number of groups or channels.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected contact has joined Telegram’s maximum number of groups or channels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选联系人加入的群组或频道数量已达 Telegram 上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選聯絡人加入的群組或頻道數量已達 Telegram 上限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した連絡先は、Telegram で参加できるグループまたはチャンネル数の上限に達しています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một liên hệ được chọn đã tham gia số lượng nhóm hoặc kênh tối đa của Telegram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contact sélectionné a atteint le nombre maximum de groupes ou de chaînes autorisé par Telegram."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contacto seleccionado alcanzó el número máximo de grupos o canales permitido por Telegram."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 연락처가 이미 Telegram에서 가입할 수 있는 최대 개수의 그룹 또는 채널에 가입되어 있습니다."
          }
        }
      }
    },
    "A selected contact’s privacy settings do not allow a direct invitation. Share the room link instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected contact’s privacy settings do not allow a direct invitation. Share the room link instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选定联系人的隐私设置不允许直接邀请。请分享房间链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選定聯絡人的隱私設定不允許直接邀請。請分享房間連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した連絡先のプライバシー設定では、直接の招待が許可されていません。代わりにルームリンクを共有してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt quyền riêng tư của người liên hệ đã chọn không cho phép lời mời trực tiếp. Thay vào đó hãy chia sẻ liên kết phòng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres de confidentialité d’un contact sélectionné ne permettent pas une invitation directe. Partagez plutôt le lien de la salle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de privacidad de un contacto seleccionado no permite una invitación directa. En su lugar, comparte el enlace de la sala."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 연락처의 개인정보 보호 설정에서 직접 초대를 허용하지 않습니다. 대신 방 링크를 공유하세요."
          }
        }
      }
    },
