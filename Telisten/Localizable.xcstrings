    "Partial streams resume from disk. Oldest cached music is removed when this limit is reached.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial streams resume from disk. Oldest cached music is removed when this limit is reached."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分流从磁盘恢复。当达到此限制时，最旧的缓存音乐将被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分流從磁碟恢復。當達到此限制時，最舊的快取音樂將被刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部分ストリームがディスクから再開されます。この制限に達すると、キャッシュされた最も古い音楽が削除されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luồng một phần tiếp tục từ đĩa. Nhạc được lưu trong bộ nhớ đệm cũ nhất sẽ bị xóa khi đạt đến giới hạn này."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux partiels reprennent à partir du disque. La musique la plus ancienne mise en cache est supprimée lorsque cette limite est atteinte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transmisiones parciales se reanudan desde el disco. La música almacenada en caché más antigua se elimina cuando se alcanza este límite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부분 스트림은 디스크에서 재개됩니다. 이 제한에 도달하면 가장 오래 캐시된 음악이 제거됩니다."
          }
        }
      }
    },
    "Pass clicks through lyrics. Reopen Floating Lyrics or press ⇧⌘L to unlock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass clicks through lyrics. Reopen Floating Lyrics or press ⇧⌘L to unlock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过歌词传递点击次数。重新打开浮动歌词或按 ⇧⌘L 解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過歌詞傳遞點擊次數。重新開啟浮動歌詞或按 ⇧⌘L 解鎖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞をクリックして通過させます。フローティング歌詞を再度開くか、⇧⌘L を押してロックを解除します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển số nhấp chuột qua lời bài hát. Mở lại Lời bài hát nổi hoặc nhấn ⇧⌘L để mở khóa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez les clics à travers les paroles. Rouvrez les paroles flottantes ou appuyez sur ⇧⌘L pour déverrouiller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar clics a través de las letras. Vuelva a abrir Letras flotantes o presione ⇧⌘L para desbloquear."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사를 통해 클릭을 전달합니다. 부동 가사를 다시 열거나 ⇧⌘L을 눌러 잠금을 해제하세요."
          }
        }
      }
    },
