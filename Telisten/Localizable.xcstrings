    "Tap the heart beside a track to keep it here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the heart beside a track to keep it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击曲目旁边的心形将其保留在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊曲目旁的心形將其保留在此處。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックの横にあるハートをタップして、ここに保持します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào trái tim bên cạnh một bản nhạc để giữ nó ở đây."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le cœur à côté d'une piste pour le conserver ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el corazón al lado de una pista para mantenerlo aquí."
          }
        },
        "ko": {
          "stringUnit": {
