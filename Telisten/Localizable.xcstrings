    "A private player for every track already living in your Telegram account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private player for every track already living in your Telegram account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Telegram 帐户中已存在的每首曲目的私人播放器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Telegram 帳戶中已存在的每首曲目的私人播放器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram アカウントにすでに存在するすべてのトラックのプライベート プレーヤー。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình phát riêng tư cho mọi bản nhạc đã có trong tài khoản Telegram của bạn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lecteur privé pour chaque piste déjà présente sur votre compte Telegram."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reproductor privado para cada pista que ya esté en tu cuenta de Telegram."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 Telegram 계정에 이미 존재하는 모든 트랙에 대한 개인 플레이어입니다."
          }
        }
      }
    },
    "A selected contact has joined Telegram’s maximum number of groups or channels.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected contact has joined Telegram’s maximum number of groups or channels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选定的联系人已加入 Telegram 的最大数量的群组或频道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選定的聯絡人已加入 Telegram 的最大數量的群組或頻道。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した連絡先が Telegram の最大数のグループまたはチャネルに参加しました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một liên hệ được chọn đã tham gia số lượng nhóm hoặc kênh tối đa của Telegram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contact sélectionné a rejoint le nombre maximum de groupes ou de chaînes de Telegram."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contacto seleccionado se ha unido al número máximo de grupos o canales de Telegram."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 연락처가 텔레그램의 최대 그룹 또는 채널 수에 합류했습니다."
          }
        }
      }
    },
    "A selected contact’s privacy settings do not allow a direct invitation. Share the room link instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected contact’s privacy settings do not allow a direct invitation. Share the room link instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选定联系人的隐私设置不允许直接邀请。请分享房间链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選定聯絡人的隱私設定不允許直接邀請。請分享房間連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した連絡先のプライバシー設定では、直接の招待が許可されていません。代わりにルームリンクを共有してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt quyền riêng tư của người liên hệ đã chọn không cho phép lời mời trực tiếp. Thay vào đó hãy chia sẻ liên kết phòng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres de confidentialité d’un contact sélectionné ne permettent pas une invitation directe. Partagez plutôt le lien de la salle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de privacidad de un contacto seleccionado no permite una invitación directa. En su lugar, comparta el enlace de la sala."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 연락처의 개인정보 보호 설정은 직접 초대를 허용하지 않습니다. 대신 회의실 링크를 공유하세요."
          }
        }
      }
    },
