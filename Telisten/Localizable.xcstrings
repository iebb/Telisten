    "Your Telegram admin role does not allow this action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Telegram admin role does not allow this action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Telegram 管理员角色不允许此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Telegram 管理員角色不允許此操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram 管理者の役割では、このアクションは許可されていません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai trò quản trị viên Telegram của bạn không cho phép hành động này."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rôle d'administrateur Telegram ne permet pas cette action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rol de administrador de Telegram no permite esta acción."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 Telegram 관리자 역할은 이 작업을 허용하지 않습니다."
          }
        }
      }
    },
    "Your Telegram session expired. Sign in again to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Telegram session expired. Sign in again to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Telegram 会话已过期。重新登录以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Telegram 會話已過期。重新登入以繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram セッションの有効期限が切れました。続行するには、再度サインインしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên Telegram của bạn đã hết hạn. Đăng nhập lại để tiếp tục."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session Telegram a expiré. Connectez-vous à nouveau pour continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de Telegram expiró. Inicia sesión nuevamente para continuar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텔레그램 세션이 만료되었습니다. 계속하려면 다시 로그인하세요."
          }
        }
      }
    },
