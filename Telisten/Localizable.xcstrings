    "%lld tracks could not be downloaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tracks could not be downloaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法下载 %lld 首歌曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法下載 %lld 首歌曲。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 曲をダウンロードできませんでした。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải xuống %lld bài hát."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger %lld titres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron descargar %lld canciones."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld곡을 다운로드할 수 없습니다."
          }
        }
      }
    },
