    "This permanently deletes %@ from Telegram. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes %@ from Telegram. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从 Telegram 中永久删除 %@。此操作无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將從 Telegram 中永久刪除 %@。此操作無法撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、%@ が Telegram から完全に削除されます。これを元に戻すことはできません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này sẽ xóa vĩnh viễn %@ khỏi Telegram. Điều này không thể hoàn tác được."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement %@ de Telegram. Cela ne peut pas être annulé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente %@ de Telegram. Esto no se puede deshacer."
          }
        },
