    "Your Telegram admin role does not allow this action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Telegram admin role does not allow this action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Telegram 管理员角色不允许此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Telegram 管理員角色不允許此操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
