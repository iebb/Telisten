            "value": "只有管​​理员才能在此群组或频道中启动 Listen Together。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管​​理員才能在此群組或頻道中啟動 Listen Together。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループまたはチャネルで Listen Together を開始できるのは管理者だけです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ quản trị viên mới có thể bắt đầu Nghe cùng nhau trong nhóm hoặc kênh này."
          }
        },
        "fr": {
          "stringUnit": {
