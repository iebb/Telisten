    "Signing out removes this account's MTProto session keys from Keychain. Other accounts stay signed in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out removes this account's MTProto session keys from Keychain. Other accounts stay signed in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录会从钥匙串中删除此账户的 MTProto 会话密钥。其他账户会保持登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出會從鑰匙圈中刪除此帳戶的 MTProto 工作階段金鑰。其他帳戶會保持登入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトすると、このアカウントの MTProto セッション キーがキーチェーンから削除されます。他のアカウントはサインインしたままになります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đăng xuất sẽ xóa khóa phiên MTProto của tài khoản này khỏi Chuỗi khóa. Các tài khoản khác vẫn đăng nhập."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion supprime les clés de session MTProto de ce compte du trousseau. Les autres comptes restent connectés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar sesión, se eliminan del Llavero las claves de sesión MTProto de esta cuenta. Las demás cuentas mantienen la sesión iniciada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하면 이 계정의 MTProto 세션 키가 키체인에서 제거됩니다. 다른 계정은 로그인된 상태로 유지됩니다."
          }
        }
      }
    },
