    "Use the base URL of an LRCLIB-compatible server. Telisten requests /api/get and /api/search; cached lyrics stay available offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the base URL of an LRCLIB-compatible server. Telisten requests /api/get and /api/search; cached lyrics stay available offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用兼容 LRCLIB 的服务器根 URL。Telisten 会请求 /api/get 和 /api/search；已缓存的歌词可离线使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相容 LRCLIB 的伺服器根 URL。Telisten 會請求 /api/get 和 /api/search；已快取的歌詞可離線使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB 互換サーバーのベース URL を使用します。 Telisten は /api/get および /api/search をリクエストします。キャッシュされた歌詞はオフラインでも利用できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng URL gốc của máy chủ tương thích với LRCLIB. Telisten gửi yêu cầu đến /api/get và /api/search; lời bài hát đã lưu vẫn dùng được khi ngoại tuyến."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l’URL de base d’un serveur compatible LRCLIB. Telisten interroge /api/get et /api/search ; les paroles mises en cache restent accessibles hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice la URL base de un servidor compatible con LRCLIB. Telisten solicita /api/get y /api/search; Las letras almacenadas en caché permanecen disponibles sin conexión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB 호환 서버의 기본 URL을 사용하세요. Telisten은 /api/get 및 /api/search를 요청합니다. 캐시된 가사는 오프라인에서도 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "Use the chat button to ask the bot for music, then return here to play it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the chat button to ask the bot for music, then return here to play it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用聊天按钮向机器人询问音乐，然后返回此处播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用聊天按鈕向機器人詢問音樂，然後回到此處播放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット ボタンを使用してボットに音楽をリクエストし、ここに戻って音楽を再生します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng nút trò chuyện để yêu cầu bot phát nhạc, sau đó quay lại đây để phát."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton de discussion pour demander de la musique au bot, puis revenez ici pour la lire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el botón de chat para pedirle música al bot y luego regrese aquí para reproducirla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 버튼을 사용하여 봇에게 음악을 요청한 다음 여기로 돌아와서 재생하세요."
          }
        }
      }
    },
    "Used": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used"
          }
        },
        "zh-Hans": {
